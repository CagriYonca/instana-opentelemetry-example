INSTANA_AGENT_KEY=your_instana_agent_key_here
# Download key for artifact-public.instana.io Maven repo (required for agent bootstrap).
# Find it at: Instana UI → More → Agents → Install Agent → "Download Key"
INSTANA_DOWNLOAD_KEY=your_instana_download_key_here
INSTANA_AGENT_ENDPOINT=ingress-red-saas.instana.io
INSTANA_AGENT_ENDPOINT_PORT=443
